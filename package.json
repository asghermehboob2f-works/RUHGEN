{
  "name": "ruhgen",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "sync:media": "node scripts/sync-media.cjs",
    "kill:dev": "node scripts/kill-dev-processes.cjs",
    "prebuild": "node scripts/kill-dev-processes.cjs && node scripts/sync-media.cjs",
    "dev": "concurrently -n next,api -c cyan,magenta \"next dev\" \"npm run dev:backend\"",
    "dev:next": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:backend": "npm --prefix backend run dev",
    "dev:full": "npm run dev",
    "build": "next build",
    "start": "next start",
    "start:backend": "node backend/src/server.js",
    "start:frontend": "next start",
    "start:cluster": "node scripts/start-production.js",
    "lint": "eslint",
    "clear:local": "node scripts/clear-local-data.cjs --yes --next",
    "clear:data": "node scripts/clear-local-data.cjs --yes"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
