# ─── RUHGEN Platform Environment Configuration Example ────────────────────────
# Copy this file to .env or .env.local for local development.

# --- Backend Configuration ---
PORT=4000
BACKEND_PORT=4000
BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_BACKEND_URL=
DATA_DIR=./backend/data

# --- Security & Auth ---
# IMPORTANT: Generate strong random secrets for production deployment!
ADMIN_JWT_SECRET=change-me-to-a-secure-random-secret-in-production
ADMIN_SECRET=change-me-to-a-secure-random-secret-in-production
USER_JWT_SECRET=change-me-to-a-secure-random-secret-in-production

# --- Initial Seed Admin Account ---
ADMIN_SEED_EMAIL=admin@ruhgen.local
ADMIN_SEED_PASSWORD=change-me-immediately
ADMIN_SEED_NAME=Administrator
ADMIN_SEED_DISABLE_SYNC=0

# --- Free / Demo Section API Key (Landing Page /#preview) ---
DEMO_NVIDIA_API_KEY=your_demo_nvidia_api_key_here
NVIDIA_GENAI_API_KEY=your_demo_nvidia_api_key_here

# --- Image Studio (Qwen Model) API Key ---
QWEN_API_KEY=your_qwen_studio_api_key_here
STUDIO_QWEN_API_KEY=your_qwen_studio_api_key_here
STUDIO_IMAGE_API_KEY=your_qwen_studio_api_key_here


# --- SMTP Email Configuration ---
SMTP_HOST=mail.ruhgen.in
SMTP_PORT=465
SMTP_USER=verify@ruhgen.in
SMTP_PASS=your_smtp_password_here
SMTP_FROM_EMAIL=verify@ruhgen.in
SMTP_FROM_NAME=RUHGEN

# --- Public Domain & Verification Settings ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VERIFY_GRACE_DAYS=7
VERIFY_LINK_TTL_HOURS=72
VERIFY_OTP_TTL_MINUTES=15
VERIFY_MAX_RESEND_PER_DAY=5
VERIFY_RESEND_COOLDOWN_MINUTES=2

# --- Razorpay Payment Gateway ---
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
