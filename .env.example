# ─── RUHGEN Root Environment Configuration Example ───────────────────────────
# Copy this file to .env at the root of the project.

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_SITE_URL=https://ruhgen.com
NEXT_PUBLIC_API_URL=https://ruhgen-b.onrender.com

# --- Express Backend Configuration ---
PORT=4000
BACKEND_PORT=4000
DATA_DIR=./data

# --- Security & Auth ---
ADMIN_JWT_SECRET=change-me-to-a-secure-random-secret-in-production
USER_JWT_SECRET=change-me-to-a-secure-random-secret-in-production

# --- Initial Admin Seed Credentials ---
ADMIN_SEED_EMAIL=admin@ruhgen.local
ADMIN_SEED_PASSWORD=change-me-immediately
ADMIN_SEED_NAME=Administrator

# --- Third-Party AI Engine API Keys (Server-Side Only) ---
NVIDIA_GENAI_API_KEY=your_nvidia_genai_api_key_here
QWEN_API_KEY=your_qwen_studio_api_key_here

# --- SMTP Email Configuration ---
SMTP_HOST=mail.ruhgen.in
SMTP_PORT=465
SMTP_USER=verify@ruhgen.in
SMTP_PASS=your_smtp_password_here
SMTP_FROM_EMAIL=verify@ruhgen.in
SMTP_FROM_NAME=RUHGEN

# --- Razorpay Payment Gateway ---
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
