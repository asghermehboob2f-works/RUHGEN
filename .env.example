# ─── RUHGEN Root Environment Configuration Example ───────────────────────────
# Copy this file to .env at the root of the project.

# --- Next.js Frontend & Public Config ---
NEXT_PUBLIC_SITE_URL=https://ruhgen.in
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4000

# --- Express Backend Configuration ---
PORT=4000
BACKEND_PORT=4000
DATA_DIR=./backend/data

# --- Security & Auth ---
ADMIN_JWT_SECRET=change-me-to-a-secure-random-secret-in-production
ADMIN_SECRET=change-me-to-a-secure-random-secret-in-production

# --- Initial Admin Seed Credentials ---
ADMIN_SEED_EMAIL=admin@ruhgen.local
ADMIN_SEED_PASSWORD=change-me-immediately
ADMIN_SEED_NAME=Administrator

# --- KIE.ai Production AI Provider (SERVER-SIDE ONLY — NEVER EXPOSE TO BROWSER) ---
KIE_API_KEY=your_kie_api_key_here
KIE_BASE_URL=https://api.kie.ai
KIE_WEBHOOK_SECRET=your_kie_webhook_secret_here

# --- Fallback / Legacy Image Studio Engine Configuration ---
RUGEN_STANDARD_API_KEY=your_standard_image_api_key_here
RUGEN_STANDARD_API_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
RUGEN_STANDARD_MODEL=flux.2-klein-4b

RUGEN_PREMIUM_API_KEY=your_premium_image_api_key_here
RUGEN_PREMIUM_API_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
RUGEN_PREMIUM_MODEL=flux.2-klein-4b


# --- SMTP Email Infrastructure ---
MAIL_HOST=mail.ruhgen.in
MAIL_PORT=465
MAIL_USERNAME=verify@ruhgen.in
MAIL_PASSWORD=your_smtp_password_here
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=verify@ruhgen.in
MAIL_FROM_NAME=RUHGEN

# --- Razorpay Payment Gateway ---
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
